################################################################################
# Example Terraform Variables
#
# This file shows example values for variables.
# DO NOT use this file directly - set these in HCP Terraform workspace instead.
#
# IMPORTANT: All infrastructure (VPC, subnets, KMS, Secrets Manager) is
# automatically created. You only need to provide your license and TLS certs
# as HCP Terraform workspace variables.
################################################################################

#------------------------------------------------------------------------------
# General Configuration (Optional - has defaults)
#------------------------------------------------------------------------------

aws_region           = "us-east-1"
environment          = "prod"
resource_name_prefix = "infragoose-vault"

#------------------------------------------------------------------------------
# Network Configuration (Optional - auto-created with defaults)
#------------------------------------------------------------------------------

vpc_cidr = "10.0.0.0/16" # Default VPC CIDR

#------------------------------------------------------------------------------
# Vault FQDN - REQUIRED
# You already have this set in your HCP Terraform workspace
#------------------------------------------------------------------------------

vault_fqdn = "vault.infragoose.com"

#------------------------------------------------------------------------------
# Vault License and TLS Certificates - REQUIRED (SENSITIVE)
# Add these as SENSITIVE variables in HCP Terraform workspace
# DO NOT add these to terraform.tfvars - use the HCP Terraform UI instead
#------------------------------------------------------------------------------

# vault_license = <<-EOT
#   (entire content of your .hclic file)
# EOT

# vault_tls_cert = <<-EOT
#   -----BEGIN CERTIFICATE-----
#   (your TLS certificate in PEM format)
#   (include full certificate chain)
#   -----END CERTIFICATE-----
# EOT

# vault_tls_key = <<-EOT
#   -----BEGIN PRIVATE KEY-----
#   (your TLS private key in PEM format)
#   -----END PRIVATE KEY-----
# EOT

# vault_ca_bundle = <<-EOT
#   -----BEGIN CERTIFICATE-----
#   (your CA certificate bundle in PEM format)
#   -----END CERTIFICATE-----
# EOT

#------------------------------------------------------------------------------
# KMS Configuration (Optional - auto-created)
# KMS key for auto-unseal is automatically created by infrastructure.tf
#------------------------------------------------------------------------------

kms_deletion_window = 10 # Days before KMS key is permanently deleted

#------------------------------------------------------------------------------
# Vault Configuration (Optional - showing defaults)
#------------------------------------------------------------------------------

vault_version  = "1.18.2+ent"
asg_node_count = 6 # 6 nodes for high availability

vm_instance_type = "m7i.large" # 2 vCPU, 8 GB RAM

vault_default_lease_ttl_duration = "1h"
vault_max_lease_ttl_duration     = "768h"

vault_port_api     = "8200"
vault_port_cluster = "8201"

load_balancing_scheme = "INTERNAL" # Use "EXTERNAL" for public access

vault_raft_performance_multiplier = 5

#------------------------------------------------------------------------------
# Storage Configuration (Optional - showing defaults)
#------------------------------------------------------------------------------

vm_boot_disk_configuration = {
  volume_type           = "gp3"
  volume_size           = 30
  delete_on_termination = true
  encrypted             = true
}

vm_vault_data_disk_configuration = {
  volume_type           = "gp3"
  volume_size           = 100
  volume_iops           = 3000
  volume_throughput     = 125
  delete_on_termination = true
  encrypted             = true
}

vm_vault_audit_disk_configuration = {
  volume_type           = "gp3"
  volume_size           = 50
  delete_on_termination = true
  encrypted             = true
}

# Optional: S3 bucket for automated Raft snapshots
# vault_snapshots_bucket_arn = "arn:aws:s3:::vault-snapshots-infragoose"

################################################################################
# HOW TO ADD SENSITIVE VARIABLES IN HCP TERRAFORM:
#
# 1. Go to your workspace → Variables
# 2. Click "Add variable"
# 3. Select "Terraform variable"
# 4. Enter variable name (e.g., "vault_license")
# 5. Paste the entire file content into the value field
# 6. CHECK THE "Sensitive" CHECKBOX ← IMPORTANT!
# 7. Click "Save variable"
# 8. Repeat for all 4 sensitive variables:
#    - vault_license
#    - vault_tls_cert
#    - vault_tls_key
#    - vault_ca_bundle
################################################################################
