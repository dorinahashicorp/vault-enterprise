# Ignore Terraform runtime files and sensitive state
.terraform/
.terraform.lock.hcl
.terraform.tfstate
.terraform.tfstate.backup
*.tfplan
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore any local environment files
.env
.env.*

# Ignore license files
*.hclic

# Ignore certificate files
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# OS / editor files
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# Backup files
*.bak
*.backup
